# TCEffectPlayer 3.4.0.245 contains adapters for optional player and XMagic
# implementations that are not packaged by the current Flutter dependency set.
# These exact rules are generated by AGP when checking the release classpath.
-dontwarn com.tencent.rtmp.ITXVodPlayListener$ITXVodAudioFrameDataListener
-dontwarn com.tencent.rtmp.TXVodDef$TXVodAudioFrameData
-dontwarn com.tencent.xmagic.XmagicApi$XmagicLightGameListener
-dontwarn com.tencent.xmagic.XmagicApi
-dontwarn com.tommy.rtmp.IIXVodPlayListener$IIXVodAudioFrameDataListener
-dontwarn com.tommy.rtmp.IXVodDef$IXVodAudioFrameData

# SDK panel models are serialized through Gson.
-keep class com.tencent.effect.beautykit.model.** { *; }
